          <filter class='categorical' column='[federated.0l8f9k80xlnruj1alrf6d0ssutmx].[none:Country:nk]'>
            <groupfilter count='6' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
